# .gitignore — Git ignore rules for DTN Crypto Simulator.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
env/

# UV
uv.lock

# Testing / Coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Simulation results (regeneratable)
results/*.json
results/*.csv
results/*.pcap

# PCAP captures
*.pcap

# Environment / Secrets
.env
.env.*
!*.env.example
credentials.json

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/

# MkDocs build output
site/

# Ruff
.ruff_cache/

# Qoder
.qoder/
